# GenePattern Module Manifest

LSID=urn:lsid:broad.mit.edu:cancer.software.genepattern.module.generated:00000:1
name=gatk.FilterMutectCalls
version=1
author=GenePattern Team, Broad Institute
description=Filters somatic SNVs and indels called by Mutect2. Applies hard filters and a probabilistic model to the raw Mutect2 calls to distinguish true somatic mutations from sequencing artifacts and germline variants. This is step 4 in the GATK4 Best Practices somatic variant calling pipeline, run after GetPileupSummaries, CalculateContamination, and LearnReadOrientationModel.
categories=Variant Analysis;Somatic Variant Calling
commandLine=bash <libdir>gatk_filtermutectcalls_wrapper.sh --input.vcf <input.vcf> <input.vcf.tbi> --reference <reference> <reference.fai> <reference.dict> --output.vcf.name <output.vcf.name> <stats.file> <contamination.table> <tumor.segmentation> <orientation.bias.artifact.priors> <arguments.file> <gatk.config.file>
cpuType=any
os=any
language=Java
taskType=Java
taskDoc=README.md
quality=development
privacy=public
job.cpuCount=2
job.memory=8Gb
job.docker.image=broadinstitute/gatk\:4.1.4.1
src.repo=https://github.com/broadinstitute/gatk
documentationUrl=https://github.com/genepattern/gatk.FilterMutectCalls


# Parameters

p1_MODE=IN
p1_TYPE=FILE
p1_description=VCF file of somatic variants produced by Mutect2. This is the unfiltered output of the Mutect2 somatic variant calling step. If bgzipped (.vcf.gz), also provide the corresponding tabix index via the input.vcf.tbi parameter. Passed to GATK as -V / --variant.
p1_fileFormat=vcf;vcf.gz;bcf
p1_name=input.vcf
p1_numValues=1..1
p1_optional=
p1_type=java.io.File

p2_MODE=IN
p2_TYPE=FILE
p2_description=Tabix index file (.tbi) for the input VCF. Required when the input VCF is bgzipped (.vcf.gz). The wrapper stages both the VCF and this index into the same directory so GATK can locate the index alongside the VCF.
p2_fileFormat=tbi;idx
p2_name=input.vcf.tbi
p2_numValues=0..1
p2_optional=on
p2_prefix_when_specified=--input.vcf.tbi 
p2_type=java.io.File

p3_MODE=IN
p3_TYPE=FILE
p3_description=Reference genome FASTA file. Must match the genome build used when running Mutect2. GATK also requires a .fai index (provide via the reference.fai parameter) and a .dict sequence dictionary (provide via reference.dict). Passed to GATK as -R / --reference.
p3_fileFormat=fa;fasta;fna
p3_name=reference
p3_numValues=1..1
p3_optional=
p3_type=java.io.File

p4_MODE=IN
p4_TYPE=FILE
p4_description=FASTA index file (.fai) for the reference genome, generated by samtools faidx. The wrapper stages both the reference and this index into the same directory so GATK can locate the index alongside the FASTA.
p4_fileFormat=fai
p4_name=reference.fai
p4_numValues=0..1
p4_optional=on
p4_prefix_when_specified=--reference.fai 
p4_type=java.io.File

p5_TYPE=TEXT
p5_default_value=filtered_variants.vcf.gz
p5_description=Name for the output filtered VCF file. If the name ends in .vcf.gz GATK will produce a bgzipped VCF with a .tbi tabix index. If it ends in .vcf GATK will produce an uncompressed VCF. Passed to GATK as -O / --output.
p5_name=output.vcf.name
p5_numValues=1..1
p5_optional=
p5_type=java.lang.String

p6_MODE=IN
p6_TYPE=FILE
p6_description=Stats file output by Mutect2 (typically named <output>.vcf.gz.stats). Contains per-read-group and per-orientation statistics used by the filtering model. If not provided GATK will attempt to locate it automatically. Passed to GATK as --stats.
p6_fileFormat=stats;txt
p6_name=stats.file
p6_numValues=0..1
p6_optional=on
p6_prefix_when_specified=--stats.file 
p6_type=java.io.File

p7_MODE=IN
p7_TYPE=FILE
p7_description=Contamination table produced by CalculateContamination. Contains per-sample contamination fraction estimates used to filter out variants likely due to cross-sample contamination. Passed to GATK as --contamination-table.
p7_fileFormat=table;txt
p7_name=contamination.table
p7_numValues=0..1
p7_optional=on
p7_prefix_when_specified=--contamination.table 
p7_type=java.io.File

p8_MODE=IN
p8_TYPE=FILE
p8_description=Tumor segmentation table produced by CalculateContamination (the --tumor-segmentation output). Contains minor allele fraction estimates per genomic segment, used to improve somatic variant filtering accuracy. Passed to GATK as --tumor-segmentation.
p8_fileFormat=table;txt
p8_name=tumor.segmentation
p8_numValues=0..1
p8_optional=on
p8_prefix_when_specified=--tumor.segmentation 
p8_type=java.io.File

p9_MODE=IN
p9_TYPE=FILE
p9_description=Read orientation model artifact priors file (.tar.gz archive) produced by LearnReadOrientationModel. Used by FilterMutectCalls to filter orientation bias artifacts such as OxoG damage. Passed to GATK as --orientation-bias-artifact-priors.
p9_fileFormat=tar.gz
p9_name=orientation.bias.artifact.priors
p9_numValues=0..1
p9_optional=on
p9_prefix_when_specified=--orientation.bias.artifact.priors 
p9_type=java.io.File

p10_MODE=IN
p10_TYPE=FILE
p10_description=Sequence dictionary file (.dict) for the reference genome, generated by samtools dict or Picard CreateSequenceDictionary. GATK requires this to be in the same directory as the reference FASTA. The wrapper stages this file alongside the reference so GATK can auto-discover it.
p10_fileFormat=dict
p10_name=reference.dict
p10_numValues=0..1
p10_optional=on
p10_prefix_when_specified=--reference.dict 
p10_type=java.io.File

p11_MODE=IN
p11_TYPE=FILE
p11_description=Optional GATK arguments file containing additional parameters to pass to FilterMutectCalls (one argument or argument=value per line). Use this to specify advanced GATK options not exposed as module parameters (e.g., --contamination-estimate, --threshold-strategy, --min-allele-fraction, --mitochondria-mode, --java-options, --tmp-dir). Passed to GATK as --arguments_file.
p11_fileFormat=txt
p11_name=arguments.file
p11_numValues=0..1
p11_optional=on
p11_prefix_when_specified=--arguments.file 
p11_type=java.io.File

p12_MODE=IN
p12_TYPE=FILE
p12_description=Optional GATK configuration file (properties format) to customize GATK behavior including logging, performance settings, and default tool arguments. Passed to GATK as --gatk-config-file.
p12_fileFormat=properties;conf;config;txt
p12_name=gatk.config.file
p12_numValues=0..1
p12_optional=on
p12_prefix_when_specified=--gatk.config.file 
p12_type=java.io.File

